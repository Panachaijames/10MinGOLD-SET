# Copy this file to .env and replace the token with a long random value.
APP_TOKEN=replace-with-a-long-random-token

# The watcher uses the account already signed in to MetaTrader 5.
DATA_SOURCE=mt5
MT5_SYMBOL=GOLD.wis
MT5_TERMINAL_PATH=
# Broker server timezone. 'auto' measures it from a live tick and remembers it;
# set a number (Wisdom Financial runs at 3) to skip the wait when the market is shut.
MT5_SERVER_UTC_OFFSET_HOURS=auto
TIMEFRAMES=10,15
# Which crossovers to push: bullish, bearish, or both.
ALERT_DIRECTIONS=bullish,bearish
POLL_INTERVAL_SECONDS=0.5
# Seconds after a candle's scheduled close before the wall-clock fallback treats it as closed
# when no next candle has appeared (daily break, Friday close). Keep this generous: a small
# value lets local clock skew evaluate a candle the server still considers open.
BAR_CLOSE_GRACE_SECONDS=12.0
# Candles fetched per evaluation and the minimum accepted. MACD(12,26,9) needs >= 260 closed
# candles for the EMA seed to wash out; fewer means "history still syncing", not a signal.
HISTORY_BARS=350
MIN_HISTORY_BARS=260
# After a restart, crosses that closed within this many seconds are still pushed; older ones are logged only.
CATCH_UP_MAX_AGE_SECONDS=900
# A gap between watcher cycles longer than this is logged as sleep/hang.
OFFLINE_GAP_ALERT_SECONDS=120

# Web Push identifies the sender with a mailto: address or HTTPS URL.
VAPID_SUBJECT=mailto:replace-me@example.com
# An M10/M15 signal is stale after ten minutes; the push service drops undelivered messages after TTL.
PUSH_TTL_SECONDS=600
# Change this to the HTTPS Tailscale/Cloudflare address before enabling mobile push.
PUBLIC_APP_URL=http://localhost:8000/

# Runtime files (SQLite and VAPID key) are kept outside source control.
# DATA_SOURCE=demo automatically uses DATA_DIR/demo so synthetic alerts never reach real devices.
DATA_DIR=backend/data
LOG_LEVEL=INFO

# Where confirmed alerts go. local = pywebpush from this machine (v1); cloud = insert into Supabase,
# where the push-fanout Edge Function sends the notifications and the watchdog sees heartbeats.
PUSH_MODE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
HEARTBEAT_INTERVAL_SECONDS=15

# LINE Messaging API alerts (bypasses browser spam filters and sleeping device restrictions).
# Create a free bot at https://developers.line.biz/ to get your Channel Access Token and User ID.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Twelve Data Cloud Market Data (alternative to local MT5).
# Set DATA_SOURCE=twelvedata to run entirely in the cloud without needing MT5 open.
# Get a free API key at https://twelvedata.com/ (800 free requests/day).
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD

